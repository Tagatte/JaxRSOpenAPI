create sequence Concert_SEQ start with 1 increment by 50
create sequence Notification_SEQ start with 1 increment by 50
create sequence Ticket_SEQ start with 1 increment by 50
create table Concert (date date, endTime integer not null, isCanceled boolean not null, isDeleted boolean not null, isValidated boolean not null, placeNumber integer not null, popularity integer not null, startTime integer not null, validationDate date, admin_id bigint, id bigint not null, organizer_id bigint, price bigint, description varchar(255), location varchar(255), musicalGenre varchar(255), name varchar(255), primary key (id))
create table Notification (concert_id bigint, id bigint not null, content varchar(255), type varchar(255), primary key (id))
create table Person (id bigint generated by default as identity (start with 1), Type varchar(31) not null, email varchar(255), firstName varchar(255), lastName varchar(255), phone varchar(255), primary key (id))
create table Person_Concert (artists_id bigint not null, concerts_id bigint not null)
create table Ticket (cancelDate date, canceled boolean not null, date date, refundDate date, refunded boolean not null, concert_id bigint, id bigint not null, price bigint, user_id bigint, primary key (id))
