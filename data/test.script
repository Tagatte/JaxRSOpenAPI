CREATE MEMORY TABLE PUBLIC.CONCERT(ID BIGINT NOT NULL PRIMARY KEY,DATE DATE,DESCRIPTION VARCHAR(255),ENDTIME INTEGER NOT NULL,ISCANCELED BOOLEAN NOT NULL,ISDELETED BOOLEAN NOT NULL,ISVALIDATED BOOLEAN NOT NULL,LOCATION VARCHAR(255),MUSICALGENRE VARCHAR(255),NAME VARCHAR(255),PLACENUMBER INTEGER NOT NULL,POPULARITY INTEGER NOT NULL,PRICE BIGINT,STARTTIME INTEGER NOT NULL,VALIDATIONDATE DATE,ADMIN_ID BIGINT,ORGANIZER_ID BIGINT)
CREATE MEMORY TABLE PUBLIC.NOTIFICATION(ID BIGINT NOT NULL PRIMARY KEY,CONTENT VARCHAR(255),TYPE VARCHAR(255),CONCERT_ID BIGINT,CONSTRAINT FK4DVK518SK2HY9MU70Q9UAYD0K FOREIGN KEY(CONCERT_ID) REFERENCES PUBLIC.CONCERT(ID))
CREATE MEMORY TABLE PUBLIC.PERSON(TYPE VARCHAR(31) NOT NULL,ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,EMAIL VARCHAR(255),FIRSTNAME VARCHAR(255),LASTNAME VARCHAR(255),PHONE VARCHAR(255))
ALTER TABLE PUBLIC.PERSON ALTER COLUMN ID RESTART WITH 11
CREATE MEMORY TABLE PUBLIC.PERSON_CONCERT(ARTISTS_ID BIGINT NOT NULL,CONCERTS_ID BIGINT NOT NULL,CONSTRAINT FK725HEAMHEQK3OTG1D7GJM8UD0 FOREIGN KEY(CONCERTS_ID) REFERENCES PUBLIC.CONCERT(ID),CONSTRAINT FKPE10CIDI0NH5FUEWXMNX1QGDQ FOREIGN KEY(ARTISTS_ID) REFERENCES PUBLIC.PERSON(ID))
CREATE MEMORY TABLE PUBLIC.TICKET(ID BIGINT NOT NULL PRIMARY KEY,CANCELDATE DATE,CANCELED BOOLEAN NOT NULL,DATE DATE,PRICE BIGINT,REFUNDDATE DATE,REFUNDED BOOLEAN NOT NULL,CONCERT_ID BIGINT,USER_ID BIGINT,CONSTRAINT FKIN9KJ2WIEJNS9PTUW1PT351KG FOREIGN KEY(CONCERT_ID) REFERENCES PUBLIC.CONCERT(ID),CONSTRAINT FKKOC12GHIPT2WKABMIFY07BQ2I FOREIGN KEY(USER_ID) REFERENCES PUBLIC.PERSON(ID))
ALTER TABLE PUBLIC.CONCERT ADD CONSTRAINT FKMB245NANCPSA6DE09I6RRT67Y FOREIGN KEY(ADMIN_ID) REFERENCES PUBLIC.PERSON(ID)
ALTER TABLE PUBLIC.CONCERT ADD CONSTRAINT FKEGQSH0SSH4T4N4UUP1UVEOFSP FOREIGN KEY(ORGANIZER_ID) REFERENCES PUBLIC.PERSON(ID)
